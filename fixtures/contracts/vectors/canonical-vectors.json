[
  {
    "name": "empty-object",
    "input": {},
    "expected": "{}"
  },
  {
    "name": "unsorted-keys",
    "input": {
      "b": 1,
      "a": 2
    },
    "expected": "{\"a\":2,\"b\":1}"
  },
  {
    "name": "nested-object-and-array-order",
    "input": {
      "z": {
        "y": 1,
        "x": 2
      },
      "a": [
        3,
        2,
        1
      ]
    },
    "expected": "{\"a\":[3,2,1],\"z\":{\"x\":2,\"y\":1}}"
  },
  {
    "name": "string-escaping",
    "input": {
      "a": "line\nbreak\"quote\\slash\ttab"
    },
    "expected": "{\"a\":\"line\\nbreak\\\"quote\\\\slash\\ttab\"}"
  },
  {
    "name": "unicode-key-order-utf16",
    "input": {
      "é": 1,
      "z": 2
    },
    "expected": "{\"z\":2,\"é\":1}"
  },
  {
    "name": "emoji-key-after-ascii",
    "input": {
      "👍": 1,
      "a": 2
    },
    "expected": "{\"a\":2,\"👍\":1}"
  },
  {
    "name": "numbers",
    "input": {
      "n": 0,
      "m": 1e+21,
      "k": 0.1
    },
    "expected": "{\"k\":0.1,\"m\":1e+21,\"n\":0}"
  },
  {
    "name": "array-preserves-order",
    "input": [
      {
        "b": 1,
        "a": 2
      },
      {
        "d": 3,
        "c": 4
      }
    ],
    "expected": "[{\"a\":2,\"b\":1},{\"c\":4,\"d\":3}]"
  },
  {
    "name": "booleans-and-null",
    "input": {
      "t": true,
      "f": false,
      "n": null,
      "s": "x"
    },
    "expected": "{\"f\":false,\"n\":null,\"s\":\"x\",\"t\":true}"
  },
  {
    "name": "deep-nesting",
    "input": {
      "a": {
        "b": {
          "c": {
            "d": [
              1,
              {
                "e": "f"
              }
            ]
          }
        }
      }
    },
    "expected": "{\"a\":{\"b\":{\"c\":{\"d\":[1,{\"e\":\"f\"}]}}}}"
  }
]
