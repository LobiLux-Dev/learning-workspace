{
  "name": "learning-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.22.1",
    "npm": "12.2.1"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "prebuild": "node scripts/check-runtime.mjs",
    "build": "tsc -b && npm run schemas:generate",
    "postbuild": "node scripts/finalize-build.mjs",
    "pretypecheck": "node scripts/check-runtime.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test packages/*/test/*.test.ts tests/*.test.ts spikes/opencode-v2/test/*.test.ts",
    "schemas:generate": "node packages/schemas/scripts/generate-json-schema.mjs",
    "learn": "node packages/cli/dist/index.js",
    "probe:environment": "node scripts/probe-environment.mjs",
    "spike:opencode": "node spikes/opencode-v2/run.mjs",
    "check": "npm run typecheck && npm test && npm run probe:environment"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "typescript": "5.9.3",
    "@opencode/plugin": "2.1.3",
    "@opencode/client": "2.1.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
